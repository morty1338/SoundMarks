    "onboarding.source.spotify.steps": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Öffne die Datenschutzseite deines Spotify-Kontos.\n2. Fordere die Extended Streaming History an.\n3. Warte auf die E-Mail mit dem Archiv und komm zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Open your Spotify account privacy page.\n2. Request the Extended Streaming History.\n3. Wait for the email with the archive, then come back here."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Откройте страницу приватности аккаунта Spotify.\n2. Запросите Extended Streaming History.\n3. Дождитесь письма с архивом и вернитесь сюда."
          }
        }
      }
