    "settings.geofences.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du wieder an einem gespeicherten Ort bist, erinnern wir dich an den Song von damals. Dafür braucht die App den Standortzugriff „Immer“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you’re back at a saved place, we’ll remind you which song played there. This needs “Always” location access."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда снова окажешься в отмеченном месте, напомним, какая песня здесь играла. Для этого приложению нужен доступ к геопозиции «Всегда»."
          }
        }
      }
    },
