      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Rang steigt mit jedem neuen Ort. Mit Stern: exklusive Platten für hohe Ränge. Das Aussehen einer einzelnen Platte änderst du im Stapel über „…“."
          }
        },
        "en" : {
