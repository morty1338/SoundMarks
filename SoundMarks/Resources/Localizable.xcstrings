      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh den Planeten auf den Platz eines Nachbarn – der rückt nach. Am Bildschirmrand scrollt das Karussell weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the planet onto a neighbour's spot – it makes room. At the screen edge the carousel scrolls on."
          }
        },
        "ru": {
