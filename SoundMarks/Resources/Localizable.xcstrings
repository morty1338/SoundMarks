    "onboarding.intro.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir finden, wo und was du gehört hast – aus deinem Wiedergabeverlauf und deinen Fotos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ll find where and what you were listening to, from your streaming history and your photos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдём, где и что вы слушали, по вашей истории прослушиваний и фотографиям."
          }
        }
      }
    },
    "onboarding.intro.privacy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wird nur auf diesem Telefon verarbeitet. Die App hat keinen eigenen Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is processed on this phone only. The app has no server of its own."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё обрабатывается только на телефоне. Своего сервера у приложения нет."
          }
        }
      }
    },
