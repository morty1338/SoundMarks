    "onboarding.period.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne mit einem Jahr – das geht schneller und ist übersichtlicher. Den Rest kannst du später scannen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with a single year — it’s faster and easier to review. You can scan the rest later."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните с одного года — так быстрее и понятнее. Остальные годы можно просканировать потом."
          }
        }
      }
    },
