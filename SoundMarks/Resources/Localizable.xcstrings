    "profile.setup.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil bleibt nur auf diesem Handy. Freunde sehen Spitzname und Avatar – deinen Planeten nur die, die du hinzufügst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile stays on this phone only. Friends see your nickname and avatar, and only people you add see your planet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профиль хранится только на этом телефоне. Друзья увидят ник и аватар, а твою планету — только те, кого ты добавишь."
          }
