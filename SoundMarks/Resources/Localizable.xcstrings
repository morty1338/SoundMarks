    "profile.skins.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Rang steigt mit jedem neuen Ort. Mit Stern: exklusive Platten für hohe Ränge. Das Aussehen einer einzelnen Platte änderst du im Stapel über „…“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your rank grows with every new place. Starred records are exclusive to high ranks. Change a single record's look in the stack via “…”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ранг растёт с каждым новым местом. Со звёздочкой — эксклюзивные пластинки для высоких рангов. Вид отдельной пластинки меняется в стопке через «…»."
