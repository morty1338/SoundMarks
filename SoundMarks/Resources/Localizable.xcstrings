    "planet.edit.gridHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh einen Planeten auf einen anderen Platz, halte ihn am Rand für die Nachbarseite. Das Kreuz entfernt ihn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a planet onto another spot, hold it at the edge to move it to the next page. The cross removes it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащи планету на место другой, подержи у края — уедет на соседнюю страницу. Крестик убирает её с экрана."
          }
        }
